/* pages/edu/index.wxss */

.edu-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 头部 */
.edu-header {
  padding: 0 4rpx 32rpx;
}

.edu-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}

.edu-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 玩法卡 */
.game-card {
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.game-card-hover {
  background: var(--bg-color);
}

.game-icon {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  color: var(--primary-deep);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.game-icon.is-warm {
  background: var(--warning-light);
  border-color: var(--warning-line);
  color: var(--warning-color);
}

.game-info {
  flex: 1;
  min-width: 0;
}

.game-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.game-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: var(--text-tertiary);
}

.game-meta {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.meta-tag {
  font-size: 21rpx;
  line-height: 1.4;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
}

.meta-tag.is-green {
  background: var(--primary-light);
  border-color: var(--primary-line);
  color: var(--primary-deep);
}

.meta-tag.is-warm {
  background: var(--warning-light);
  border-color: var(--warning-line);
  color: var(--warning-color);
}

.game-arrow {
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-deco);
  align-self: center;
}

/* 更多玩法 */
.more-box {
  border: 2rpx dashed var(--primary-line);
  border-radius: var(--radius);
  padding: 36rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-tertiary);
}

.edu-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-deco);
  line-height: 1.7;
}
