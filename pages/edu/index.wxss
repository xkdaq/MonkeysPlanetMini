/* pages/edu/edu.wxss */

.edu-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 头部 */
.edu-header {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.edu-header-main {
  display: flex;
  align-items: center;
}

.edu-seal {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.edu-header-txt {
  flex: 1;
  min-width: 0;
}

.edu-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.edu-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 进度概览 */
.stat-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16%;
  height: 68%;
  width: 2rpx;
  background: #f0f0f0;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
}

.stat-value.warn {
  color: #faad14;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #999999;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin: 0 8rpx 20rpx;
}

/* 玩法卡片 */
.game-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.game-card:active {
  background: #fafafa;
}

.game-icon {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.game-icon.wheel {
  background: #07c160;
}

.game-icon.pair {
  background: #faad14;
}

.game-info {
  flex: 1;
  min-width: 0;
}

.game-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.game-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #999999;
}

.game-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.meta-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #e8f5e9;
  color: #07c160;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.game-arrow {
  flex: none;
  margin-left: 12rpx;
  font-size: 40rpx;
  color: #cccccc;
}

.edu-tip {
  margin-top: 30rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #bbbbbb;
  text-align: center;
}
