/* pages/edu/wheel.wxss */

.wheel-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 题库条 */
.bank-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid var(--border-color);
}

.bank-bar:active {
  background: var(--bg-color);
}

.bank-bar-left {
  flex: 1;
  min-width: 0;
}

.bank-bar-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-bar-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-bar-right {
  flex: none;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
}

.bank-bar-txt {
  font-size: 24rpx;
  color: var(--primary-color);
}

.bank-bar-arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
  color: var(--primary-color);
}

/* 转盘 */
.wheel-wrap {
  position: relative;
  margin: 0 auto;
  border-radius: 50%;
}

.wheel-canvas {
  display: block;
}

.wheel-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 空态 / 错误 */
.empty-hint {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.retry-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 40rpx;
  border: 2rpx solid var(--primary-color);
  border-radius: 40rpx;
  color: var(--primary-color);
  font-size: 26rpx;
}

/* 工具条 */
.tool-bar {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.tool-item {
  padding: 12rpx 32rpx;
  margin: 0 12rpx;
  border-radius: 40rpx;
  background: #ffffff;
  border: 2rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.tool-item:active {
  background: var(--bg-color);
}

/* 题目卡片 */
.q-card {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--border-color);
  animation: qIn 0.35s ease-out;
}

@keyframes qIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.q-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.q-tag {
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 22rpx;
}

.q-score {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.q-index {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.q-title {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.btn-row {
  display: flex;
  align-items: center;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  background: var(--primary-color);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  flex: 1;
  height: 80rpx;
  margin-left: 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-outline:active {
  background: var(--primary-light);
}

.analysis-box {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--text-primary);
}

/* 思考提示 */
.think-tip {
  position: fixed;
  left: 50%;
  top: 30%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.82);
  color: #ffffff;
  padding: 24rpx 36rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  z-index: 2000;
  animation: tipIn 0.25s ease-out;
}

.think-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--primary-color);
}

@keyframes tipIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  animation: fadeIn 0.2s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s cubic-bezier(0.25, 0.85, 0.3, 1);
  border: 2rpx solid var(--border-color);
}

@keyframes slideUp {
  from {
    transform: translateY(60rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.sheet-list {
  max-height: 56vh;
}

.bank-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: var(--bg-color);
  border: 2rpx solid transparent;
}

.bank-option.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.opt-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-option.active .opt-name {
  color: var(--primary-color);
  font-weight: 600;
}

.opt-count {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-color);
  margin-bottom: 12rpx;
}

.setting-left {
  flex: 1;
  min-width: 0;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
}

.setting-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.setting-arrow {
  font-size: 32rpx;
  color: var(--text-deco);
}

.history-item {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--bg-color);
  margin-bottom: 8rpx;
}

.history-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.history-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-deco);
}

.sheet-close {
  margin-top: 20rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--border-color);
  color: var(--text-tertiary);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-close.ghost {
  margin-top: 12rpx;
}
