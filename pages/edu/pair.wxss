/* pages/edu/pair.wxss */

.pair-page {
  min-height: 100vh;
  padding: 20rpx 20rpx 60rpx;
  box-sizing: border-box;
}

/* 关卡条 */
.level-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.level-info {
  flex: 1;
  min-width: 0;
}

.level-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.level-name {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #07c160;
}

.level-pick {
  flex: none;
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 24rpx;
  color: #666666;
}

.progress-row {
  display: flex;
  align-items: center;
  margin: 16rpx 4rpx 20rpx;
}

.track {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: #eeeeee;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 6rpx;
  background: #07c160;
  transition: width 0.4s ease;
}

.remain {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 统计 */
.stat-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat + .stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16%;
  height: 68%;
  width: 2rpx;
  background: #f0f0f0;
}

.stat .v {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
}

.stat .v.score {
  color: #faad14;
}

.stat .v.combo {
  color: #07c160;
}

.stat .v.cleared {
  color: #07c160;
}

.stat .v.time {
  font-size: 28rpx;
}

.stat .l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999999;
}

/* 工具 */
.tool-row {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

.tool {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid #e8e8e8;
  font-size: 24rpx;
  color: #666666;
}

.tool.on {
  background: #07c160;
  border-color: #07c160;
  color: #ffffff;
}

/* 棋盘 */
.board {
  display: flex;
  gap: 16rpx;
}

.col {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 14rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.col-head {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.col.q .dot {
  background: #2563eb;
}

.col.a .dot {
  background: #11b981;
}

.card {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 22rpx;
  line-height: 1.5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card.q {
  background: #f0f6ff;
  border-color: #c9ddfd;
  color: #1d4ed8;
}

.card.a {
  background: #ecfdf3;
  border-color: #b7e4cd;
  color: #067647;
}

.card.sel {
  border-color: #07c160;
  transform: translateY(-2rpx);
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.18);
}

.card.bad {
  animation: shake 0.42s ease;
  border-color: #ff4d4f !important;
}

.card.good {
  animation: pop 0.5s ease forwards;
}

.card.hint {
  animation: glow 1.1s ease infinite;
}

.card.gone {
  visibility: hidden;
  height: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border-width: 0;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-8rpx); }
  35% { transform: translateX(8rpx); }
  55% { transform: translateX(-6rpx); }
  75% { transform: translateX(4rpx); }
}

@keyframes pop {
  0% { transform: scale(1); opacity: 1; }
  45% { transform: scale(1.05); opacity: 0.9; }
  100% { transform: scale(0.88); opacity: 0; }
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 0 3rpx #faad14; }
  50% { box-shadow: 0 0 0 6rpx #faad14; }
}

/* 操作 */
.act-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.btn {
  padding: 16rpx 28rpx;
  margin: 0 10rpx 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #ffffff;
  border: 2rpx solid #e8e8e8;
  color: #666666;
}

.btn.primary {
  background: #07c160;
  border-color: #07c160;
  color: #ffffff;
}

.btn.ghost {
  color: #07c160;
  border-color: #b7e4cd;
}

.btn.gold {
  background: #fffaf0;
  border-color: #f2e3c2;
  color: #a1651a;
}

.btn.warn {
  color: #ff4d4f;
  border-color: rgba(255, 77, 79, 0.32);
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbbbbb;
  line-height: 1.7;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s cubic-bezier(0.25, 0.85, 0.3, 1);
}

@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.sheet-list {
  max-height: 56vh;
}

.lvl-opt {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #fafafa;
  border: 2rpx solid transparent;
  margin-bottom: 8rpx;
}

.lvl-opt.active {
  background: #e8f5e9;
  border-color: #07c160;
}

.lvl-opt.locked {
  opacity: 0.45;
}

.opt-idx {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: #eeeeee;
  color: #999999;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lvl-opt.active .opt-idx {
  background: #07c160;
  color: #ffffff;
}

.opt-name {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.opt-meta {
  flex: none;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.sheet-close {
  margin-top: 20rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #e8e8e8;
  color: #999999;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通关弹窗 */
.result {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 1001;
  width: 80%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border-top: 6rpx solid #07c160;
  padding: 46rpx 36rpx 32rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  animation: rise 0.35s cubic-bezier(0.2, 0.9, 0.3, 1);
}

@keyframes rise {
  from { transform: translate(-50%, -46%); opacity: 0; }
  to { transform: translate(-50%, -50%); opacity: 1; }
}

.badge {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.r-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.r-lead {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #999999;
}

.tally {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin: 30rpx 0;
}

.tally-item {
  width: 25%;
  text-align: center;
}

.t-v {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.t-l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999999;
}

.r-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
