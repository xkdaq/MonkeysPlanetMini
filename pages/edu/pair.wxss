/* pages/edu/pair.wxss */

.pair-page {
  min-height: 100vh;
  padding: 20rpx 20rpx 60rpx;
  box-sizing: border-box;
}

/* 关卡条 */
.level-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border-color);
}

.level-info {
  flex: 1;
  min-width: 0;
}

.level-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.level-name {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--primary-color);
}

.level-pick {
  flex: none;
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.progress-row {
  display: flex;
  align-items: center;
  margin: 16rpx 4rpx 20rpx;
}

.track {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--border-color);
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--primary-color);
  transition: width 0.4s ease;
}

.remain {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 统计 */
.stat-bar {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 0;
  border: 2rpx solid var(--border-color);
}

.stat {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat + .stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16%;
  height: 68%;
  width: 2rpx;
  background: var(--border-color);
}

.stat .v {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.2;
}

.stat .v.score {
  color: var(--warning-color);
}

.stat .v.combo {
  color: var(--primary-color);
}

.stat .v.cleared {
  color: var(--primary-color);
}

.stat .v.time {
  font-size: 28rpx;
}

.stat .l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* 工具 */
.tool-row {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

.tool {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tool.on {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #ffffff;
}

/* 棋盘 */
.board {
  display: flex;
  gap: 16rpx;
}

.col {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 14rpx;
  border: 2rpx solid var(--border-color);
}

.col-head {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.col.q .dot {
  background: var(--text-deco);
}

.col.a .dot {
  background: var(--primary-deep);
}

.card {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  font-size: 22rpx;
  line-height: 1.5;
  border: 2rpx solid var(--border-color);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card.q,
.card.a {
  background: var(--white);
  border-color: var(--border-color);
  color: var(--text-primary);
}

/* 选中态才上绿 */
.card.sel {
  background: var(--primary-light);
  border-color: var(--primary-color);
  color: var(--primary-deep);
}

.card.bad {
  animation: shake 0.42s ease;
  border-color: var(--danger-text) !important;
}

.card.good {
  animation: pop 0.5s ease forwards;
}

.card.hint {
  animation: glow 1.1s ease infinite;
}

.card.gone {
  visibility: hidden;
  height: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border-width: 0;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-8rpx); }
  35% { transform: translateX(8rpx); }
  55% { transform: translateX(-6rpx); }
  75% { transform: translateX(4rpx); }
}

@keyframes pop {
  0% { transform: scale(1); opacity: 1; }
  45% { transform: scale(1.05); opacity: 0.9; }
  100% { transform: scale(0.88); opacity: 0; }
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 0 3rpx var(--warning-color); }
  50% { box-shadow: 0 0 0 6rpx var(--warning-color); }
}

/* 操作 */
.act-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 三个操作按钮等宽三等分（设计稿 5C：等高胶囊、同字号） */
.act-row .btn {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  height: 76rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 76rpx;
  margin: 0 10rpx 12rpx;
  border-radius: 38rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
}

/* 按钮上的附注（免费 / -20），比主文案小一号 */
.btn-sub {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.75;
}

.btn-hover {
  opacity: 0.6;
}

.btn.primary {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: var(--white);
}

.btn.ghost {
  color: var(--primary-deep);
  border-color: var(--primary-line);
}

/* 提示要扣分，用棕色系提醒 */
.btn.gold {
  background: var(--warning-light);
  border-color: var(--warning-line);
  color: var(--warning-color);
}

/* 重新开始会清空进度，保持描边红、不做实心，避免误触 */
.btn.danger {
  color: var(--danger-text);
  border-color: var(--danger-line);
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-deco);
  line-height: 1.7;
}

/* 弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s cubic-bezier(0.25, 0.85, 0.3, 1);
  border: 2rpx solid var(--border-color);
}

@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.sheet-list {
  max-height: 56vh;
}

.lvl-opt {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--bg-color);
  border: 2rpx solid transparent;
  margin-bottom: 8rpx;
}

.lvl-opt.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.lvl-opt.locked {
  opacity: 0.45;
}

.opt-idx {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: var(--border-color);
  color: var(--text-tertiary);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lvl-opt.active .opt-idx {
  background: var(--primary-color);
  color: #ffffff;
}

.opt-name {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.opt-meta {
  flex: none;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.sheet-close {
  margin-top: 20rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--border-color);
  color: var(--text-tertiary);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通关弹窗 */
.result {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 1001;
  width: 80%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border-top: 6rpx solid var(--primary-color);
  padding: 46rpx 36rpx 32rpx;
  text-align: center;
  border: 2rpx solid var(--border-color);
  animation: rise 0.35s cubic-bezier(0.2, 0.9, 0.3, 1);
}

@keyframes rise {
  from { transform: translate(-50%, -46%); opacity: 0; }
  to { transform: translate(-50%, -50%); opacity: 1; }
}

.badge {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: var(--primary-color);
  color: #ffffff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.r-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.r-lead {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-tertiary);
}

.tally {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  margin: 30rpx 0;
}

.tally-item {
  width: 25%;
  text-align: center;
}

.t-v {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.t-l {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.r-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}
