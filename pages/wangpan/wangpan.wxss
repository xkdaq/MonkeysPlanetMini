.wangpan-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

/* 筛选头部：白底描边，吸顶 */
.filter-header {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: 0 -24rpx;
  padding: 20rpx 24rpx 18rpx;
  background: var(--white);
  border-bottom: 2rpx solid var(--border-color);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: var(--white);
  margin-bottom: 20rpx;
  padding: 16rpx 26rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--border-color);
}

.search-box-hover {
  background: var(--bg-color);
}

.search-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 分类标签栏 */
.category-bar {
  white-space: nowrap;
  margin: 0 -24rpx;
}

.subject-bar {
  margin-bottom: 14rpx;
}

.subcategory-bar {
  margin-bottom: 0;
}

.category-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 14rpx;
}

.category-list-secondary {
  gap: 12rpx;
}

.category-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--white);
  border-radius: 32rpx;
  border: 2rpx solid var(--border-color);
  transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.category-item.active {
  color: var(--white);
  background: var(--primary-color);
  border-color: var(--primary-color);
  font-weight: 600;
}

.category-item.secondary {
  padding: 8rpx 22rpx;
  font-size: 23rpx;
  background: var(--white);
  color: var(--text-tertiary);
}

/* 二级筛选选中：绿浅底 + 绿描边，不抢一级的实心绿 */
.category-item.secondary.active {
  color: var(--primary-deep);
  background: var(--primary-light);
  border-color: var(--primary-line);
  font-weight: 600;
}

/* 单列横向卡片列表 */
.content-list {
  padding-top: 24rpx;
}

.content-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: var(--radius);
  border: 2rpx solid var(--border-color);
}

.content-card-hover {
  background: var(--bg-color);
}

/* 封面图 */
.content-cover {
  width: 148rpx;
  height: 148rpx;
  flex: 0 0 148rpx;
  border-radius: 12rpx;
  background: var(--border-color);
}

/* 内容区 */
.content-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.content-title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.content-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 标签行 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin-bottom: 14rpx;
}

.top-tag {
  background: var(--white);
  border: 1rpx solid var(--primary-color);
  color: var(--primary-deep);
  font-size: 18rpx;
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

/* 标签：统一绿描边 */
.category-tag {
  font-size: 18rpx;
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  background: var(--white);
  border: 1rpx solid var(--primary-color);
  color: var(--primary-deep);
}

/* 网盘类型提示 */
.link-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: auto;
}

.pan-hint {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.pan-hint::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  opacity: 0.6;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  width: 100%;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  width: 100%;
}

/* 空状态 */
.empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  width: 100%;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}
