<view class="detail-page">
  <!-- 顶部标题区：标题 + 描边标签，正文紧跟其后 -->
  <view class="detail-hero">
    <view class="detail-title">{{title}}</view>
    <view wx:if="{{type === 'material' && categoryList.length > 0}}" class="detail-tags">
      <view wx:for="{{categoryList}}" wx:key="*this" class="detail-tag {{index === 0 ? 'is-lead' : ''}}">{{item}}</view>
    </view>
  </view>

  <!-- 正文 -->
  <view class="content-card">
    <mp-html content="{{htmlContent}}" selectable="true" bindlinktap="onLinkTap"/>
  </view>

  <!-- 网盘操作区（审核模式下隐藏） -->
  <block wx:if="{{type === 'material' && !reviewMode}}">
    <!-- 备注 / 说明 -->
    <view wx:if="{{linkRemark}}" class="remark-note">{{linkRemark}}</view>

    <!-- 获取资料：放在页面最下方 -->
    <view wx:if="{{baiduUrl || quarkUrl}}" class="get-card">
      <view class="get-label">获取资料</view>
      <view class="get-list">
        <view wx:if="{{baiduUrl}}" class="action-item" hover-class="action-item-hover" hover-stay-time="60" bindtap="onPanTap" data-pan="baidu" data-url="{{baiduUrl}}" data-code="{{baiduCode}}">
          <view class="action-icon">度</view>
          <view class="action-body">
            <text class="action-name">百度网盘</text>
            <view wx:if="{{baiduCode}}" class="action-meta">
              <text>提取码 </text>
              <text class="action-code">{{baiduCode}}</text>
              <text class="action-copy" catchtap="onCopyCode" data-code="{{baiduCode}}">复制</text>
            </view>
            <text wx:else class="action-meta">点击直接打开</text>
          </view>
          <view class="action-btn">打开</view>
        </view>
        <view wx:if="{{quarkUrl}}" class="action-item" hover-class="action-item-hover" hover-stay-time="60" bindtap="onPanTap" data-pan="quark" data-url="{{quarkUrl}}" data-code="{{quarkCode}}">
          <view class="action-icon">夸</view>
          <view class="action-body">
            <text class="action-name">夸克网盘</text>
            <view wx:if="{{quarkCode}}" class="action-meta">
              <text>提取码 </text>
              <text class="action-code">{{quarkCode}}</text>
              <text class="action-copy" catchtap="onCopyCode" data-code="{{quarkCode}}">复制</text>
            </view>
            <text wx:else class="action-meta">无需提取码，点击直接打开</text>
          </view>
          <view class="action-btn is-ghost">打开</view>
        </view>
      </view>
    </view>

    <!-- 无网盘链接 -->
    <view wx:if="{{!baiduUrl && !quarkUrl}}" class="empty-card">
      <text class="empty-text">暂未配置网盘链接</text>
    </view>
  </block>
</view>
