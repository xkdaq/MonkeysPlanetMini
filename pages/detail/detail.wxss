.detail-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

/* 顶部标题区：直出在页面上，不套卡片 */
.detail-hero {
  padding: 0 4rpx 32rpx;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.55;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

/* 标签一律描边式：首个用绿浅底，其余中性描边 */
.detail-tag {
  font-size: 21rpx;
  line-height: 1.4;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
}

.detail-tag.is-lead {
  background: var(--primary-light);
  border-color: var(--primary-line);
  color: var(--primary-deep);
}

/* 正文 */
.content-card {
  padding: 32rpx;
  background: var(--white);
  border-radius: var(--radius);
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
  font-size: 27rpx;
  line-height: 1.9;
  overflow: hidden;
}

/* 说明 / 备注 */
.remark-note {
  margin-top: 28rpx;
  padding: 26rpx 30rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-s);
  font-size: 23rpx;
  color: var(--text-tertiary);
  line-height: 1.75;
}

/* 获取资料 */
.get-card {
  margin-top: 28rpx;
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  border-radius: var(--radius);
  padding: 32rpx;
}

.get-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-deep);
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--primary-line);
}

.action-item:first-child {
  padding-top: 0;
}

.action-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.action-item-hover {
  opacity: 0.6;
}

/* 网盘图标：白底绿描边方块 */
.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  margin-right: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  background: var(--white);
  border: 2rpx solid var(--primary-line);
  color: var(--text-secondary);
}

.action-body {
  flex: 1;
  min-width: 0;
}

.action-name {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.action-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.action-code {
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: 0.08em;
}

.action-copy {
  margin-left: 16rpx;
  color: var(--primary-deep);
  font-weight: 600;
  padding: 4rpx 8rpx;
}

/* 打开按钮：主网盘实心，次网盘描边 */
.action-btn {
  flex: none;
  height: 64rpx;
  padding: 0 32rpx;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  background: var(--primary-color);
  color: var(--white);
  font-size: 25rpx;
  font-weight: 600;
}

.action-btn.is-ghost {
  background: transparent;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-deep);
  padding: 0 30rpx;
}

/* 空状态 */
.empty-card {
  margin-top: 28rpx;
  padding: 60rpx;
  text-align: center;
  background: var(--white);
  border-radius: var(--radius);
  border: 2rpx solid var(--border-color);
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}
