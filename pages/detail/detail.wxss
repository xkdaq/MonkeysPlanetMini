.detail-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 20rpx 26rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部标题区 */
.detail-hero {
  padding: 30rpx;
  background: var(--white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.detail-title.with-tags {
  margin-bottom: 20rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: var(--text-secondary);
}

.detail-tag.tag-0 {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.detail-tag.tag-1 {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.detail-tag.tag-2 {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.detail-tag.tag-3 {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.detail-tag.tag-4 {
  background: #f5f5f5;
  color: var(--text-secondary);
}

/* 内容区 */
.content-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 1.8;
  overflow: hidden;
}

/* 区块标签 */
.action-section {
  margin-bottom: 24rpx;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.label-line {
  width: 6rpx;
  height: 28rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.section-label text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* 操作列表 */
.action-list {
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.action-item:last-child {
  border-bottom: none;
}

.action-item:active {
  background: #fafafa;
}

/* 操作图标 */
.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  margin-right: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 50%;
}

.action-icon.baidu {
  color: #2196f3;
  background: #e8f4fd;
}

.action-icon.quark {
  color: #ff9800;
  background: #fff5e6;
}

/* 操作主体 */
.action-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.action-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.action-meta {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 打开按钮 */
.action-btn {
  padding: 10rpx 24rpx;
  background: var(--primary-color);
  border-radius: 24rpx;
  margin-left: 16rpx;
}

.action-btn text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--white);
}

/* 空状态卡片 */
.empty-card {
  padding: 48rpx;
  text-align: center;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 备注区 */
.remark-section {
  margin-top: -4rpx;
}

.remark-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid var(--primary-color);
}

.remark-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
