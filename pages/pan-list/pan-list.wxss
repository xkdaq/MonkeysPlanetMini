.pan-list-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: var(--white);
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx 16rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 60rpx;
}

.search-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  margin-left: 12rpx;
  font-weight: 500;
}

.clear-btn {
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 8rpx 16rpx;
  margin-left: 8rpx;
}

/* 单列横向卡片列表 */
.content-list {
  padding: 0;
}

.content-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease, background 0.15s ease;
}

.content-card:active {
  background: #fafafa;
  transform: scale(0.99);
}

/* 封面图 */
.content-cover {
  width: 148rpx;
  height: 148rpx;
  flex: 0 0 148rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

/* 内容区 */
.content-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.content-title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.top-tag {
  background: var(--white);
  border: 1rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.content-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 标签行 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin-bottom: 14rpx;
}

/* 网站风格描边标签：默认灰色描边，第一个（科目）绿色描边 */
.category-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--white);
  border: 1rpx solid #d9d9d9;
  color: var(--text-secondary);
}

.category-tag.tag-0 {
  border-color: var(--primary-color);
  color: var(--primary-color);
}

/* 网盘类型提示 */
.link-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: auto;
}

.pan-hint {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.pan-hint::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  opacity: 0.6;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  width: 100%;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
  width: 100%;
}

/* 空状态 */
.empty-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  width: 100%;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}
