.search-page {
  min-height: 100vh;
  background: var(--bg-color);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: var(--white);
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.search-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 60rpx;
}

.search-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  padding: 10rpx 20rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

/* ========== 资料搜索 - 单列横向卡片 ========== */
.content-list {
  padding: 20rpx;
}

.content-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--white);
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
  transition: transform 0.15s ease, background 0.15s ease;
}

.content-card:active {
  background: var(--bg-color);
}

.content-cover {
  width: 148rpx;
  height: 148rpx;
  flex: 0 0 148rpx;
  border-radius: 12rpx;
  background: var(--border-color);
}

.content-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.content-title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.top-tag {
  background: var(--white);
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.content-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 12rpx;
  margin-bottom: 14rpx;
}

/* 网站风格描边标签：默认灰色描边，第一个（科目）绿色描边 */
.category-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--white);
  border: 2rpx solid var(--text-deco);
  color: var(--text-secondary);
}

.category-tag.tag-0 {
  border-color: var(--primary-color);
  color: var(--primary-color);
}

.link-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: auto;
}

.pan-hint {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.pan-hint::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  opacity: 0.6;
}

/* ========== 文章搜索 - 原有列表样式 ========== */
.list {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.title-box {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.title {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.5;
  flex: 1;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 分类标签 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 标签一律描边式，不再五色浅底 */
.tag-0,
.tag-1,
.tag-2,
.tag-3,
.tag-4 {
  background-color: transparent;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-deep);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-tertiary);
}


/* 点击反馈：即时背景变化，不做位移/缩放，避免掉帧 */
.tap-hover {
  background-color: var(--bg-color) !important;
}
