/* pages/result/result.wxss */

.result-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #07c160 0%, #f5f5f5 40%);
  padding: 40rpx 30rpx;
}

/* 成绩卡片 */
.result-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

/* 正确率圆环 */
.accuracy-circle {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 50rpx;
  border-radius: 50%;
  background: conic-gradient(
    #07c160 0deg,
    #07c160 calc(var(--accuracy, 0) * 3.6deg),
    #e0e0e0 calc(var(--accuracy, 0) * 3.6deg),
    #e0e0e0 360deg
  );
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.accuracy-circle::before {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  background: var(--white);
  border-radius: 50%;
}

.circle-inner {
  position: relative;
  z-index: 1;
}

.accuracy-value {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.2;
}

.accuracy-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 统计数据 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stat-value.correct {
  color: var(--primary-color);
}

.stat-value.wrong {
  color: var(--danger-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 评价 */
.evaluation {
  font-size: 30rpx;
  color: var(--text-secondary);
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-buttons .btn {
  width: 100%;
}
