/* pages/feedback/feedback.wxss */
.feedback-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 80rpx;
}

.form-section {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

/* 反馈类型 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  background: var(--bg-color);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.type-item.active {
  background: var(--primary-color);
  color: #fff;
}

/* 输入框 */
.title-input,
.contact-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.content-textarea {
  width: 100%;
  height: 240rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.delete-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--danger-text);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 36rpx;
  text-align: center;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed var(--text-deco);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
}

.upload-btn .plus {
  font-size: 48rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.upload-btn .upload-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

/* 隐私授权同意区域 */
.privacy-link {
  color: var(--primary-color);
  font-size: 24rpx;
}
.privacy-agree-section {
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 0;
}

.privacy-agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.checkbox {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--text-deco);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  background: #fff;
}

.checkbox.checked {
  border-color: var(--primary-color);
  background: var(--primary-color);
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

.privacy-agree-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 30rpx;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  background: var(--text-deco);
}

.submit-btn::after {
  border: none;
}
