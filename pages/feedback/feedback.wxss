/* pages/feedback/feedback.wxss */
.feedback-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40px;
}

.form-section {
  background: #fff;
  margin-bottom: 10px;
  padding: 15px;
}

.section-title {
  font-size: 15px;
  font-weight: 500;
  color: #333;
  margin-bottom: 12px;
}

/* 反馈类型 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.type-item {
  padding: 8px 16px;
  background: #f5f5f5;
  border-radius: 20px;
  font-size: 14px;
  color: #666;
  transition: all 0.3s;
}

.type-item.active {
  background: #07c160;
  color: #fff;
}

/* 输入框 */
.title-input,
.contact-input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 14px;
  box-sizing: border-box;
}

.content-textarea {
  width: 100%;
  height: 120px;
  padding: 12px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 14px;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 12px;
  color: #999;
  margin-top: 8px;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.image-item {
  position: relative;
  width: 80px;
  height: 80px;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}

.delete-btn {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 20px;
  height: 20px;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  font-size: 16px;
  line-height: 18px;
  text-align: center;
}

.upload-btn {
  width: 80px;
  height: 80px;
  border: 1px dashed #ccc;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-btn .plus {
  font-size: 24px;
  color: #999;
  line-height: 1;
}

.upload-btn .upload-text {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

/* 隐私授权同意区域 */
.privacy-link {
  color: #07c160;
  font-size: 12px;
}
.privacy-agree-section {
  background: #fff;
  padding: 12px 15px;
  margin-bottom: 0;
}

.privacy-agree-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.checkbox {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  border: 1.5px solid #ccc;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 1px;
  background: #fff;
}

.checkbox.checked {
  border-color: #07c160;
  background: #07c160;
}

.check-icon {
  color: #fff;
  font-size: 12px;
  line-height: 1;
}

.privacy-agree-text {
  flex: 1;
  font-size: 12px;
  color: #666;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-section {
  padding: 20px 15px;
}

.submit-btn {
  width: 100%;
  height: 46px;
  background: #07c160;
  color: #fff;
  border-radius: 23px;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  background: #ccc;
}

.submit-btn::after {
  border: none;
}
