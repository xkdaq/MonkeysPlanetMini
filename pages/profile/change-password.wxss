/* pages/profile/change-password.wxss */
.change-password-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20px;
}

.form-section {
  background: #fff;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 15px;
}

.section-title {
  font-size: 15px;
  font-weight: 500;
  color: #333;
  margin-bottom: 12px;
}

.input-wrap {
  display: flex;
  align-items: center;
}

.password-input {
  flex: 1;
  height: 44px;
  padding: 0 12px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 15px;
}

.submit-section {
  margin-top: 30px;
}

.submit-btn {
  width: 100%;
  height: 46px;
  background: #07c160;
  color: #fff;
  border-radius: 23px;
  font-size: 16px;
  font-weight: 500;
}

.submit-btn::after {
  border: none;
}
