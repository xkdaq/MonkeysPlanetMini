/* pages/profile/change-password.wxss */
.change-password-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 40rpx;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid var(--border-color);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
}

.password-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 30rpx;
}

.submit-section {
  margin-top: 60rpx;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.submit-btn::after {
  border: none;
}
