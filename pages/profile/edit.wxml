<!--pages/profile/edit.wxml-->
<view class="edit-container">
  <!-- 头像 -->
  <view class="form-item" bindtap="onChooseAvatar">
    <text class="label">头像</text>
    <view class="avatar-wrap">
      <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/>
      <image class="arrow" src="/images/mine-arrow-right.png" mode="aspectFit"/>
    </view>
  </view>

  <!-- 昵称 -->
  <view class="form-item">
    <text class="label">昵称</text>
    <input class="input" type="text" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="50"/>
  </view>

  <!-- 性别 -->
  <view class="form-item">
    <text class="label">性别</text>
    <picker mode="selector" range="{{['未知', '男', '女']}}" value="{{gender}}" bindchange="onGenderChange">
      <view class="picker">
        <text>{{gender === 1 ? '男' : gender === 2 ? '女' : '未知'}}</text>
        <image class="arrow" src="/images/mine-arrow-right.png" mode="aspectFit"/>
      </view>
    </picker>
  </view>

  <!-- 用户名（只读） -->
  <view class="form-item readonly">
    <text class="label">用户名</text>
    <text class="value">{{userInfo.username || '用户_' + userInfo.id}}</text>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button class="save-btn" bindtap="onSave">保存</button>
  </view>
</view>