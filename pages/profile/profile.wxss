/* pages/profile/profile.wxss */

.profile-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 用户卡片：白底描边 */
.user-card {
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 36rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  background: var(--primary-light);
}

.avatar.is-default {
  margin: 0 auto 20rpx;
  display: block;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.nickname-wrap {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: 33rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 12rpx;
}

.gender-icon {
  width: 30rpx;
  height: 30rpx;
}

.username {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-tertiary);
}

/* 编辑：描边胶囊 */
.edit-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 26rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 26rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.edit-btn-hover {
  background: var(--bg-color);
}

/* 登录区域 */
.login-section {
  text-align: center;
  padding: 10rpx 0;
}

.login-tip {
  display: block;
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-bottom: 24rpx;
}

.login-btn {
  display: inline-block;
  background: var(--primary-color);
  color: var(--white);
  padding: 18rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1.5;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  opacity: 0.85;
}

/* 学习概览：三格统计 */
.stat-card {
  display: flex;
  margin-top: 24rpx;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 30rpx 0;
}

.stat-card-hover {
  background: var(--bg-color);
}

.stat-item {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.stat-item + .stat-item {
  border-left: 2rpx solid var(--border-color);
}

.stat-value {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 8rpx;
}

.stat-value.is-accent {
  color: var(--primary-deep);
}

.stat-label {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--text-tertiary);
}

/* 菜单卡片 */
.menu-card {
  margin-top: 24rpx;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: var(--bg-color);
}

/* 菜单图标：统一浅绿描边方块，不再彩色底 */
.menu-icon-wrap {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border-radius: 18rpx;
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
}

.menu-icon-img {
  width: 30rpx;
  height: 30rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-badge {
  flex: none;
  font-size: 21rpx;
  color: var(--text-tertiary);
  margin-right: 16rpx;
}

.menu-arrow {
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: var(--text-deco);
}

/* 退出登录：一行文字 */
.logout-text {
  margin-top: 44rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-tertiary);
  padding: 16rpx 0;
}

.logout-text-hover {
  opacity: 0.6;
}
