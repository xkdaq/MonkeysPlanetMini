/* pages/profile/profile.wxss */

.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 用户卡片 */
.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f5;
  padding: 4rpx;
  margin-right: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.avatar-wrap.default-avatar {
  margin: 0 auto 20rpx;
  width: 100rpx;
  height: 100rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-detail {
  flex: 1;
}

.nickname-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-right: 12rpx;
}

.gender-icon {
  width: 32rpx;
  height: 32rpx;
}

.username {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.phone {
  font-size: 26rpx;
  color: #999;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background: #e6f7f0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #07c160;
}

/* 登录区域 */
.login-section {
  text-align: center;
  padding: 10rpx 0;
}

.login-tip {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.login-btn {
  display: inline-block;
  background: #07c160;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  opacity: 0.9;
}

/* 菜单卡片 */
.menu-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-badge {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.menu-arrow-img {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.3;
}

/* 退出登录 */
.logout-section {
  padding: 10rpx 0 30rpx;
}

.logout-btn {
  width: 100%;
  background: #fff;
  color: #ff4d4f;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #fff5f5;
}
