<!--pages/profile/change-password.wxml-->
<view class="change-password-container">
  <!-- 旧密码 -->
  <view class="form-section">
    <view class="section-title">旧密码</view>
    <view class="input-wrap">
      <input class="password-input" 
             type="password"
             placeholder="请输入旧密码" 
             value="{{oldPassword}}"
             bindinput="onOldPasswordInput"/>
    </view>
  </view>

  <!-- 新密码 -->
  <view class="form-section">
    <view class="section-title">新密码</view>
    <view class="input-wrap">
      <input class="password-input" 
             type="password"
             placeholder="请输入新密码（6-20位）" 
             value="{{newPassword}}"
             bindinput="onNewPasswordInput"/>
    </view>
  </view>

  <!-- 确认新密码 -->
  <view class="form-section">
    <view class="section-title">确认新密码</view>
    <view class="input-wrap">
      <input class="password-input" 
             type="password"
             placeholder="请再次输入新密码" 
             value="{{confirmPassword}}"
             bindinput="onConfirmPasswordInput"/>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="onSubmit">修改密码</button>
  </view>
</view>
