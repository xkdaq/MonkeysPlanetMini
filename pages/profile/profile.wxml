<!--pages/profile/profile.wxml-->
<view class="profile-container">
  <!-- 用户信息卡片：白底描边，不再整块上色 -->
  <view class="user-card">
    <block wx:if="{{isLogin}}">
      <view class="user-info">
        <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="user-detail">
          <view class="nickname-wrap">
            <text class="nickname">{{userInfo.nickname || '微信用户'}}</text>
            <image class="gender-icon" wx:if="{{userInfo.gender === 1}}" src="/images/icon-nan.png" mode="aspectFit"/>
            <image class="gender-icon" wx:elif="{{userInfo.gender === 2}}" src="/images/icon-nv.png" mode="aspectFit"/>
          </view>
          <text class="username">ID: {{userInfo.username || '用户_' + userInfo.id}}</text>
        </view>
        <view class="edit-btn" hover-class="edit-btn-hover" hover-stay-time="60" bindtap="onEditProfile">编辑</view>
      </view>
    </block>
    <block wx:else>
      <view class="login-section">
        <image class="avatar is-default" src="/images/default-avatar.png" mode="aspectFill"/>
        <text class="login-tip">登录后享受更多功能</text>
        <button class="login-btn" bindtap="onLogin">立即登录</button>
      </view>
    </block>
  </view>

  <!-- 学习概览：三格描边统计卡 -->
  <view class="stat-card" wx:if="{{isLogin}}" hover-class="stat-card-hover" hover-stay-time="60" bindtap="onStudyRecords">
    <view class="stat-item">
      <view class="stat-value">{{stats.total}}</view>
      <view class="stat-label">练习次数</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.totalQuestions}}</view>
      <view class="stat-label">总题数</view>
    </view>
    <view class="stat-item">
      <view class="stat-value is-accent">{{stats.totalDurationText}}</view>
      <view class="stat-label">学习时长</view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-card" wx:if="{{isLogin}}">
    <!-- 绑定手机号（审核模式下隐藏） -->
    <view class="menu-item" wx:if="{{!reviewMode}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onBindPhone">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/mine-bind-phone.png" mode="aspectFit"/>
      </view>
      <text class="menu-text">绑定手机号</text>
      <text class="menu-badge" wx:if="{{!userInfo.hasPhone}}">未绑定</text>
      <text class="menu-badge" wx:else>已绑定</text>
      <text class="menu-arrow">›</text>
    </view>
    <!-- 修改密码（仅已绑定手机号的用户显示，审核模式下隐藏） -->
    <view class="menu-item" wx:if="{{userInfo.hasPhone && !reviewMode}}" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onChangePassword">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/mine-change-pwd.png" mode="aspectFit"/>
      </view>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onStudyRecords">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/mine-study.png" mode="aspectFit"/>
      </view>
      <text class="menu-text">学习记录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 其他功能 -->
  <view class="menu-card">
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="goToSettings">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/mine-setting.png" mode="aspectFit"/>
      </view>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onAbout">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/mine-about-us.png" mode="aspectFit"/>
      </view>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <!-- 问题反馈功能 -->
    <view class="menu-item" hover-class="menu-item-hover" hover-stay-time="60" bindtap="onFeedback">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="/images/mine-hao-ping.png" mode="aspectFit"/>
      </view>
      <text class="menu-text">问题反馈</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录：降级为一行文字 -->
  <view class="logout-text" wx:if="{{isLogin}}" hover-class="logout-text-hover" hover-stay-time="60" bindtap="onLogout">退出登录</view>
</view>
