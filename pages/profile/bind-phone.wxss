/* pages/profile/bind-phone.wxss */
.bind-phone-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20px;
}

.form-section {
  background: #fff;
  border-radius: 12px;
  padding: 15px;
  margin-bottom: 15px;
}

.section-title {
  font-size: 15px;
  font-weight: 500;
  color: #333;
  margin-bottom: 12px;
}

.input-wrap {
  display: flex;
  align-items: center;
}

.phone-input,
.password-input {
  flex: 1;
  height: 44px;
  padding: 0 12px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 15px;
}

.code-wrap {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  height: 44px;
  padding: 0 12px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 15px;
  margin-right: 10px;
}

.send-btn {
  width: 120px;
  height: 44px;
  line-height: 44px;
  background: #07c160;
  color: #fff;
  font-size: 14px;
  border-radius: 8px;
  padding: 0;
}

.send-btn.disabled {
  background: #ccc;
}

.send-btn::after {
  border: none;
}

.tips {
  font-size: 12px;
  color: #999;
  margin-top: 8px;
}

.submit-section {
  margin-top: 30px;
}

.submit-btn {
  width: 100%;
  height: 46px;
  background: #07c160;
  color: #fff;
  border-radius: 23px;
  font-size: 16px;
  font-weight: 500;
}

.submit-btn::after {
  border: none;
}

.notice {
  margin-top: 20px;
  padding: 15px;
  background: #f0f9f4;
  border-radius: 8px;
}

.notice text {
  font-size: 13px;
  color: #666;
  line-height: 1.6;
}

/* 已绑定状态样式 */
.bound-section {
  background: #fff;
  border-radius: 12px;
  padding: 40px 20px;
  text-align: center;
  margin-bottom: 20px;
}

.bound-icon {
  font-size: 60px;
  margin-bottom: 20px;
}

.bound-title {
  font-size: 18px;
  font-weight: 500;
  color: #333;
  margin-bottom: 15px;
}

.bound-phone {
  font-size: 24px;
  font-weight: 600;
  color: #07c160;
  margin-bottom: 20px;
  letter-spacing: 2px;
}

.bound-tip {
  font-size: 13px;
  color: #999;
}
