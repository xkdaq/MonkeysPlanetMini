/* pages/profile/bind-phone.wxss */
.bind-phone-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 40rpx;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid var(--border-color);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
}

.phone-input,
.password-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 30rpx;
}

.code-wrap {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 0;
}

.send-btn.disabled {
  background: var(--text-deco);
}

.send-btn::after {
  border: none;
}

.tips {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
}

.submit-section {
  margin-top: 60rpx;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.submit-btn::after {
  border: none;
}

.notice {
  margin-top: 40rpx;
  padding: 30rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.notice text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 已绑定状态样式 */
.bound-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  border: 2rpx solid var(--border-color);
}

.bound-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.bound-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 30rpx;
}

.bound-phone {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}

.bound-tip {
  font-size: 26rpx;
  color: var(--text-tertiary);
}
