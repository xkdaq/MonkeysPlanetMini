<!--pages/exam/exam.wxml-->
<view class="container">
  <!-- 继续上次练习：本地进度存档，无需请求 -->
  <view class="resume-card" wx:if="{{lastPractice}}">
    <view class="resume-head">
      <text class="resume-label">继续上次练习</text>
      <text class="resume-switch" wx:if="{{progressCount > 1}}" bindtap="onSwitchProgress">换一个 ›</text>
    </view>
    <view class="resume-title">{{lastPractice.label}}</view>
    <view class="resume-progress">
      <view class="resume-bar">
        <view class="resume-bar-fill" style="width: {{lastPractice.percent}}%"></view>
      </view>
      <view class="resume-num"><text class="resume-num-cur">{{lastPractice.done}}</text> / {{lastPractice.total}}</view>
    </view>
    <view class="resume-btn" hover-class="resume-btn-hover" hover-start-time="0" hover-stay-time="70" bindtap="onContinuePractice">继续练习</view>
  </view>

  <!-- 趣味背诵 -->
  <view class="section-head">
    <text class="section-name">趣味背诵</text>
    <text class="section-more" bindtap="goEduModule">333 教育综合 ›</text>
  </view>
  <view class="game-grid">
    <view class="game-card" hover-class="game-card-hover" hover-start-time="0" hover-stay-time="70" bindtap="goWheel">
      <view class="game-badge">转</view>
      <view class="game-name">抽题大转盘</view>
      <view class="game-desc">随机抽题，先想再看</view>
      <view class="game-meta">已抽 {{eduStats.wheelDrawn}} 次</view>
    </view>
    <view class="game-card" hover-class="game-card-hover" hover-start-time="0" hover-stay-time="70" bindtap="goPair">
      <view class="game-badge is-warm">连</view>
      <view class="game-name">帽子题连连看</view>
      <view class="game-desc">96 组考点闯关配对</view>
      <view class="game-meta is-warm">第 {{eduStats.pairLevel}} / 12 关</view>
    </view>
  </view>

  <!-- 选择题库 -->
  <view class="section-head">
    <text class="section-name">选择题库</text>
    <text class="section-extra">共 {{banks.length}} 个</text>
  </view>

  <view class="bank-list" wx:if="{{banks.length > 0}}">
    <view class="bank-item" wx:for="{{banks}}" wx:key="id" hover-class="bank-item-hover" hover-start-time="0" hover-stay-time="70" bindtap="onBankItemTap" data-id="{{item.id}}">
      <view class="bank-info">
        <view class="bank-name">{{item.name}}</view>
        <view class="bank-desc">{{item.description || '暂无题库描述'}}</view>
      </view>
      <text class="bank-arrow">›</text>
    </view>
  </view>
  <view class="empty-state" wx:else>
    <text>{{loading ? '题库加载中...' : '暂无题库数据'}}</text>
  </view>
</view>
