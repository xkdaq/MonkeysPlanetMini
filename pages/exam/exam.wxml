<!--pages/exam/exam.wxml-->
<view class="container">
  <block wx:if="{{isBankList}}">
    <view class="bank-list-header">
      <view>
        <view class="bank-list-title">选择题库</view>
        <view class="bank-list-desc">进入题库后再查看分类、练习和收藏</view>
      </view>
    </view>

    <view class="bank-card-list" wx:if="{{banks.length > 0}}">
      <view class="bank-card" wx:for="{{banks}}" wx:key="id" bindtap="onBankItemTap" data-id="{{item.id}}">
        <view class="bank-card-main">
          <image class="bank-cover" wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill"/>
          <view class="bank-cover bank-cover-placeholder" wx:else>题</view>
          <view class="bank-info">
            <view class="bank-name">{{item.name}}</view>
            <view class="bank-desc">{{item.description || '暂无题库描述'}}</view>
          </view>
        </view>
        <text class="bank-arrow">→</text>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text>{{loading ? '题库加载中...' : '暂无题库数据'}}</text>
    </view>
  </block>

  <block wx:else>
    <view class="bank-detail-header">
      <view class="back-btn" bindtap="onBackToBanks">← 题库列表</view>
      <view class="detail-bank-name">{{currentBankName}}</view>
      <view class="detail-bank-desc">{{selectedBank.description || '选择分类或练习方式开始刷题'}}</view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-actions">
      <view class="action-item" bindtap="onOrderPractice">
        <view class="action-icon order">
          <image src="/images/exam-order.png" mode="aspectFit" class="action-icon-img"/>
        </view>
        <text class="action-text">顺序练习</text>
      </view>
      <view class="action-item" bindtap="onRandomPractice">
        <view class="action-icon random">
          <image src="/images/exam-random.png" mode="aspectFit" class="action-icon-img"/>
        </view>
        <text class="action-text">随机练习</text>
      </view>
      <view class="action-item" bindtap="onWrongPractice">
        <view class="action-icon wrong">
          <image src="/images/exam-wrong.png" mode="aspectFit" class="action-icon-img"/>
        </view>
        <text class="action-text">错题练习</text>
      </view>
      <view class="action-item" bindtap="onFavoriteTap">
        <view class="action-icon favorite">
          <image src="/images/exam-favorite.png" mode="aspectFit" class="action-icon-img"/>
        </view>
        <text class="action-text">我的收藏</text>
      </view>
    </view>

    <!-- 科目切换：仅三级分类题库显示 -->
    <scroll-view class="subject-tabs" scroll-x="true" wx:if="{{subjects.length > 0}}">
      <view
        class="subject-tab {{currentSubjectId == item.id ? 'active' : ''}}"
        wx:for="{{subjects}}"
        wx:key="id"
        bindtap="onSubjectTap"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 分类列表 -->
    <view class="card category-section">
      <view class="card-title">题库分类</view>
      <view class="category-list" wx:if="{{categories.length > 0}}">
        <view class="category-item" wx:for="{{categories}}" wx:key="id">
          <view class="category-header" bindtap="onParentCategoryTap" data-id="{{item.id}}" data-name="{{item.name}}" data-has-children="{{item.children && item.children.length > 0}}">
            <text class="category-name">{{item.name}}</text>
            <text class="arrow" wx:if="{{!item.children || item.children.length == 0}}">→</text>
          </view>
          <view class="sub-category-list" wx:if="{{item.children && item.children.length > 0}}">
            <view class="sub-category-item" wx:for="{{item.children}}" wx:for-item="sub" wx:key="id" bindtap="onCategoryTap" data-id="{{sub.id}}" data-name="{{sub.name}}">
              <text class="sub-name">{{sub.name}}</text>
              <text class="arrow">→</text>
            </view>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:else>
        <text>暂无分类数据</text>
      </view>
    </view>
  </block>
</view>
