/* pages/exam/exam.wxss */

.bank-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.bank-list-title {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
}

.bank-list-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.bank-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bank-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease;
}

.bank-card:active {
  transform: scale(0.98);
}

.bank-card-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.bank-cover {
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.bank-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-size: 32rpx;
  font-weight: 600;
}

.bank-info {
  flex: 1;
  min-width: 0;
}

.bank-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bank-arrow {
  margin-left: 18rpx;
  font-size: 30rpx;
  color: #ccc;
}

.bank-detail-header {
  padding: 28rpx;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.back-btn {
  display: inline-flex;
  align-items: center;
  margin-bottom: 20rpx;
  color: #07c160;
  font-size: 26rpx;
}

.detail-bank-name {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
}

.detail-bank-desc {
  margin-top: 12rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
  padding: 0 10rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 22%;
  padding: 20rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  position: relative;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
}

.action-icon.order {
  background: rgba(7, 193, 96, 0.1);
}

.action-icon.random {
  background: rgba(16, 185, 129, 0.1);
}

.action-icon.wrong {
  background: rgba(59, 130, 246, 0.1);
}

.action-icon.favorite {
  background: rgba(245, 158, 11, 0.1);
}

.action-icon-img {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  z-index: 1;
}

.action-icon.order .action-icon-img {
  filter: none;
}

.action-text {
  font-size: 22rpx;
  color: #666;
  font-weight: 400;
}

.action-item .badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #ff6b6b;
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 科目切换 */
.subject-tabs {
  white-space: nowrap;
  margin: 0 0 20rpx;
  padding: 0 4rpx;
}

.subject-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 58rpx;
  margin-right: 16rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e8e8e8;
  border-radius: 30rpx;
  color: #666;
  font-size: 25rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.subject-tab.active {
  color: #07c160;
  border-color: rgba(7, 193, 96, 0.45);
  background: rgba(7, 193, 96, 0.08);
  font-weight: 500;
}

/* 分类列表 */
.category-section {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  position: relative;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 24rpx;
  background: #07c160;
  border-radius: 2rpx;
}

.category-list {
  margin-top: 10rpx;
}

.category-item {
  margin-bottom: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.category-item:last-child {
  margin-bottom: 0;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.category-header .arrow {
  font-size: 24rpx;
  color: #ccc;
}

.category-count {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.sub-category-list {
  margin-top: 16rpx;
}

.sub-category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  transition: background 0.15s ease;
}

.sub-category-item:last-child {
  margin-bottom: 0;
}

.sub-category-item:active {
  background: #f5f5f5;
}

.sub-name {
  font-size: 26rpx;
  color: #666;
}

.sub-category-item .arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  color: #999;
  font-size: 26rpx;
}


/* 教育学背诵入口 */
.edu-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 18rpx;
  border: 2rpx solid rgba(7, 193, 96, 0.30);
  box-shadow: 0 2rpx 12rpx rgba(7, 193, 96, 0.10);
}

.edu-entry:active {
  background: #f4fbf6;
}

.edu-entry-icon {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.edu-entry-info {
  flex: 1;
  min-width: 0;
}

.edu-entry-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.3;
}

.edu-entry-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edu-entry-go {
  flex: none;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 26rpx;
  background: #e8f5e9;
  color: #07c160;
  font-size: 23rpx;
}
