/* pages/exam/exam.wxss */

.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 继续上次练习 ===== */
.resume-card {
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  border-radius: var(--radius);
  padding: 36rpx;
}

.resume-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.resume-label {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--primary-deep);
}

.resume-switch {
  font-size: 23rpx;
  color: var(--text-tertiary);
  padding: 4rpx 0 4rpx 20rpx;
}

.resume-title {
  margin-top: 20rpx;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--text-primary);
  /* 「题库名 · 章节名」可能很长，最多两行 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.resume-progress {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.resume-bar {
  flex: 1;
  height: 6rpx;
  border-radius: 4rpx;
  background: #dfeee7;
  overflow: hidden;
}

.resume-bar-fill {
  height: 100%;
  background: var(--primary-color);
  border-radius: 4rpx;
  transition: width 0.25s ease;
}

.resume-num {
  flex: none;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.resume-num-cur {
  color: var(--primary-deep);
  font-weight: 600;
}

.resume-btn {
  margin-top: 32rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--primary-color);
  color: var(--white);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.resume-btn-hover {
  opacity: 0.85;
}

/* ===== 分组标题 ===== */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 36rpx 4rpx 20rpx;
}

.section-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more,
.section-extra {
  font-size: 23rpx;
  color: var(--text-tertiary);
}

.section-more {
  padding: 4rpx 0 4rpx 20rpx;
}

/* ===== 趣味背诵：两列描边卡 ===== */
.game-grid {
  display: flex;
  gap: 20rpx;
}

.game-card {
  flex: 1;
  min-width: 0;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-s);
  padding: 28rpx;
}

.game-card-hover {
  background: var(--bg-color);
}

.game-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  color: var(--primary-deep);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.game-badge.is-warm {
  background: var(--warning-light);
  border-color: var(--warning-line);
  color: var(--warning-color);
}

.game-name {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.game-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-tertiary);
}

.game-meta {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: var(--primary-deep);
}

.game-meta.is-warm {
  color: var(--warning-color);
}

/* ===== 题库列表 ===== */
.bank-list {
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 0 32rpx;
}

.bank-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.bank-item:last-child {
  border-bottom: none;
}

.bank-item-hover {
  background: var(--bg-color);
}

.bank-info {
  flex: 1;
  min-width: 0;
}

.bank-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-arrow {
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  color: var(--text-deco);
}

/* ===== 题库详情 ===== */
.bank-detail-header {
  padding: 0 4rpx 8rpx;
}

.back-btn {
  display: inline-block;
  font-size: 25rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.back-btn-hover {
  opacity: 0.6;
}

.detail-bank-name {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.detail-bank-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  margin-top: 32rpx;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 32rpx 0;
}

.action-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.action-item-hover {
  opacity: 0.6;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.action-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 科目切换 */
.subject-tabs {
  margin-top: 32rpx;
  white-space: nowrap;
}

.subject-tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--border-color);
  background: var(--white);
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.subject-tab:last-child {
  margin-right: 0;
}

.subject-tab.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
}

.subject-tab-hover {
  opacity: 0.7;
}

/* 分类列表 */
.category-card {
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 0 32rpx;
}

.category-item {
  border-bottom: 2rpx solid var(--border-color);
}

.category-item:last-child {
  border-bottom: none;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.category-header-hover {
  background: var(--bg-color);
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.category-arrow {
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: var(--text-deco);
}

.sub-category-list {
  padding-bottom: 12rpx;
}

.sub-category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 20rpx 24rpx;
  border-left: 2rpx solid var(--border-color);
  margin-left: 8rpx;
}

.sub-category-item-hover {
  background: var(--bg-color);
}

.sub-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 空状态 */
.empty-state {
  padding: 100rpx 0;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 26rpx;
}
