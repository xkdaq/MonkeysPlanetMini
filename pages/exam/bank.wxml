<!--pages/exam/bank.wxml-->
<view class="container">
  <!-- 从分享卡片直接打开时，页面栈里没有题库列表，给一个入口 -->
  <view class="entry-back" wx:if="{{isEntry}}" hover-class="entry-back-hover" hover-start-time="0" hover-stay-time="70" bindtap="backToBankList">‹ 全部题库</view>

  <view class="bank-detail-header">
    <view class="detail-bank-name">{{bankName}}</view>
    <view class="detail-bank-desc">{{bankDesc || '选择分类或练习方式开始刷题'}}</view>
  </view>

  <!-- 快捷入口（题库参数缺失时不渲染，否则会拼出 bankId=null 的练习链接） -->
  <view class="quick-actions" wx:if="{{bankId}}">
    <view class="action-item" hover-class="action-item-hover" hover-start-time="0" hover-stay-time="70" bindtap="onOrderPractice">
      <view class="action-icon">
        <image src="/images/exam-order.png" mode="aspectFit" class="action-icon-img"/>
      </view>
      <text class="action-text">顺序练习</text>
    </view>
    <view class="action-item" hover-class="action-item-hover" hover-start-time="0" hover-stay-time="70" bindtap="onRandomPractice">
      <view class="action-icon">
        <image src="/images/exam-random.png" mode="aspectFit" class="action-icon-img"/>
      </view>
      <text class="action-text">随机练习</text>
    </view>
    <view class="action-item" hover-class="action-item-hover" hover-start-time="0" hover-stay-time="70" bindtap="onWrongPractice">
      <view class="action-icon">
        <image src="/images/exam-wrong.png" mode="aspectFit" class="action-icon-img"/>
      </view>
      <text class="action-text">错题练习</text>
    </view>
    <view class="action-item" hover-class="action-item-hover" hover-start-time="0" hover-stay-time="70" bindtap="onFavoriteTap">
      <view class="action-icon">
        <image src="/images/exam-favorite.png" mode="aspectFit" class="action-icon-img"/>
      </view>
      <text class="action-text">我的收藏</text>
    </view>
  </view>

  <!-- 科目切换：仅三级分类题库显示 -->
  <scroll-view class="subject-tabs" scroll-x="true" enable-flex="true" wx:if="{{subjects.length > 0}}">
    <view
      class="subject-tab {{currentSubjectId == item.id ? 'active' : ''}}"
      wx:for="{{subjects}}"
      wx:key="id"
      hover-class="subject-tab-hover"
      hover-start-time="0"
      hover-stay-time="70"
      bindtap="onSubjectTap"
      data-id="{{item.id}}"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 分类列表 -->
  <view class="section-head">
    <text class="section-name">题库分类</text>
  </view>
  <view class="category-card" wx:if="{{categories.length > 0}}">
    <view class="category-item" wx:for="{{categories}}" wx:key="id">
      <view class="category-header" hover-class="category-header-hover" hover-start-time="0" hover-stay-time="70" bindtap="onParentCategoryTap" data-id="{{item.id}}" data-name="{{item.name}}" data-has-children="{{item.children && item.children.length > 0}}">
        <text class="category-name">{{item.name}}</text>
        <text class="category-arrow" wx:if="{{!item.children || item.children.length == 0}}">›</text>
      </view>
      <view class="sub-category-list" wx:if="{{item.children && item.children.length > 0}}">
        <view class="sub-category-item" wx:for="{{item.children}}" wx:for-item="sub" wx:key="id" hover-class="sub-category-item-hover" hover-start-time="0" hover-stay-time="70" bindtap="onCategoryTap" data-id="{{sub.id}}" data-name="{{sub.name}}" data-parent-name="{{item.name}}">
          <text class="sub-name">{{sub.name}}</text>
          <text class="category-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:else>
    <text>{{loading ? '分类加载中...' : '暂无分类数据'}}</text>
  </view>
</view>
