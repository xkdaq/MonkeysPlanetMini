<view class="article-list-page">
  <!-- 搜索框 -->
  <view class="search-box">
    <view class="search-icon-wrap">
      <image class="search-icon-img" src="/images/search.png" mode="aspectFit" />
    </view>
    <input class="search-input" placeholder="{{placeholder}}" bindinput="onInputChange" value="{{keywords}}" />
    <view class="search-btn" hover-class="tap-hover" hover-start-time="0" hover-stay-time="70" bindtap="onSearch">搜索</view>
    <view wx:if="{{keywords}}" class="clear-btn" hover-class="tap-hover" hover-start-time="0" hover-stay-time="70" bindtap="onClearSearch">清除</view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <block wx:for="{{list}}" wx:key="id">
      <view class="list-item" hover-class="tap-hover" hover-start-time="0" hover-stay-time="70" bindtap="onItemTap" data-item="{{item}}">
        <view class="title-box">
          <view wx:if="{{item.isTop == 1}}" class="top-tag">置顶</view>
          <text class="title">{{item.title}}</text>
        </view>
        <view class="info-row">
          <text class="date">{{item.date}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{loadingMore}}" class="loading">加载中...</view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">没有更多了</view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!isLoading && list.length === 0}}" class="empty-box">
    <text class="empty-text">暂无文章</text>
  </view>
</view>
