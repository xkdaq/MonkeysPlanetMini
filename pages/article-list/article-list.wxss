.article-list-page {
  min-height: 100vh;
  background-color: var(--bg-color);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.search-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  height: 60rpx;
}

.search-btn {
  font-size: 28rpx;
  color: var(--primary-color);
  padding: 10rpx 20rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: var(--text-tertiary);
  padding: 10rpx 20rpx;
}

/* 列表 */
.list {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--border-color);
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.title-box {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.top-tag {
  background: var(--white);
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.title {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.5;
  flex: 1;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-box {
  padding: 100rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}


/* 点击反馈：即时背景变化，不做位移/缩放，避免掉帧 */
.tap-hover {
  background-color: var(--bg-color) !important;
}
