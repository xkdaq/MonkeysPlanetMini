/* pages/practice/practice.wxss */

.practice-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-color);
}

/* 顶部导航：进度数 + 进度条 + 模式切换 同一行 */
.practice-header {
  flex: none;
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--white);
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.progress-info {
  flex: none;
  display: flex;
  align-items: baseline;
}

.current-index {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.total-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 6rpx;
}

.timer {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.timer-icon {
  margin-right: 8rpx;
}

.mode-switch {
  flex: none;
  display: flex;
  border: 2rpx solid var(--border-color);
  border-radius: 28rpx;
  overflow: hidden;
}

.mode-item {
  padding: 10rpx 26rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  transition: background-color 0.18s ease, color 0.18s ease;
}

.mode-item.active {
  background: var(--primary-color);
  color: var(--white);
  font-weight: 600;
}

.progress-bar {
  flex: 1;
  height: 6rpx;
  background: var(--border-color);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary-color);
  border-radius: 4rpx;
  transition: width 0.25s ease;
}

/* 题目内容 */
.question-content {
  flex: 1;
  padding: 32rpx 32rpx 40rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.question-type {
  display: none;
}

.type-tag {
  display: none;
}

.question-title {
  font-size: 32rpx;
  color: var(--text-primary);
  line-height: 1.8;
  margin-bottom: 40rpx;
}

/* 题干：独占顶部，不套卡片 */
.question-block {
  padding: 0 4rpx;
  margin-bottom: 36rpx;
}

/* 题型 + 章节：一行元信息 */
.question-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.q-type {
  flex: none;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--primary-deep);
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  border-radius: 12rpx;
  padding: 5rpx 16rpx;
}

.q-category {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-tertiary);
}

.question-title-rt {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.8;
}

.question-header {
  display: none;
}

/* 选项列表 */
.options-list {
  margin-bottom: 26rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  background: var(--white);
  border-radius: var(--radius-s);
  margin-bottom: 20rpx;
  border: 2rpx solid var(--border-color);
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

.option-item-hover {
  background: var(--bg-color);
}

.option-item.selected {
  border-color: var(--primary-color);
  background: var(--primary-light);
}

.option-item.correct {
  border-color: var(--primary-color);
  background: var(--primary-light);
}

.option-item.wrong {
  border-color: var(--danger-line);
  background: var(--danger-light);
}

.option-item.missed {
  border-color: var(--warning-color) !important;
  background: var(--warning-light) !important;
}

.option-label {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 22rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label,
.option-item.correct .option-label {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
}

.option-item.wrong .option-label {
  background: var(--danger-color);
  border-color: var(--danger-color);
  color: var(--white);
  font-weight: 600;
}

.option-content {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.option-item.correct .option-content {
  color: var(--primary-deep);
  font-weight: 600;
}

.option-item.wrong .option-content {
  color: var(--danger-text);
}

.option-status {
  margin-left: 20rpx;
  font-size: 28rpx;
}

.option-status text {
  color: var(--primary-deep);
}

.option-status text:last-child {
  color: var(--danger-text);
}

/* 文本输入 */
.text-answer {
  margin-bottom: 26rpx;
}

.answer-input {
  width: 100%;
  min-height: 200rpx;
  padding: 26rpx;
  background: var(--white);
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
  border: 2rpx solid var(--border-color);
}

.submit-btn {
  margin-top: 26rpx;
}

/* 答案解析 */
.analysis-section {
  background: var(--white);
  border-radius: var(--radius);
  padding: 30rpx;
  border: 2rpx solid var(--border-color);
}

/* 答案对比 */
.answer-compare {
  display: flex;
  gap: 52rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.compare-item {
  display: flex;
  flex-direction: column;
}

.compare-label {
  font-size: 21rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.compare-value {
  font-size: 30rpx;
  font-weight: 600;
}

.compare-value.correct {
  color: var(--primary-deep);
}

.compare-value.wrong {
  color: var(--danger-text);
}

/* 解析区域 */
.analysis-content {
  margin-top: 24rpx;
  padding: 0;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.analysis-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

/* 操作改成绿色文字链：去掉灰底胶囊和两个不同风格的 PNG 图标 */
.analysis-actions {
  display: flex;
  gap: 28rpx;
}

.action-link {
  font-size: 22rpx;
  color: var(--primary-deep);
  padding: 4rpx 0;
}

.action-link-hover {
  opacity: 0.55;
}

/* 答题卡弹窗 */
.card-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.card-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.card-content {
  position: relative;
  width: 100%;
  background: var(--white);
  border-radius: 26rpx 26rpx 0 0;
  padding: 40rpx 26rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  border: 2rpx solid var(--border-color);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 26rpx;
  color: var(--text-tertiary);
}

.card-legend {
  display: flex;
  justify-content: center;
  gap: 26rpx;
  margin-bottom: 26rpx;
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.legend-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 4rpx;
}

.legend-dot.correct {
  background: var(--macaron-mint);
  border: 2rpx solid var(--macaron-mint-ink);
}

.legend-dot.wrong {
  background: var(--macaron-rose);
  border: 2rpx solid var(--macaron-rose-ink);
}

.legend-dot.missed {
  background: var(--macaron-apricot);
  border: 2rpx solid var(--macaron-apricot-ink);
}

.legend-dot.unanswered {
  background: var(--white);
  border: 2rpx solid var(--text-deco);
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.card-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--white);
  border: 2rpx solid var(--text-deco);
}

.card-item.correct {
  background: var(--macaron-mint);
  color: var(--macaron-mint-ink);
  border-color: var(--macaron-mint-ink);
  font-weight: 600;
}

.card-item.wrong {
  background: var(--macaron-rose);
  color: var(--macaron-rose-ink);
  border-color: var(--macaron-rose-ink);
  font-weight: 600;
}

.card-item.missed {
  background: var(--macaron-apricot);
  color: var(--macaron-apricot-ink);
  border-color: var(--macaron-apricot-ink);
  font-weight: 600;
}

/* 当前题：用中性墨色加粗描边。
   之前是绿环，压在答错的红底上两个色系打架；中性色不和任何马卡龙底色冲突 */
.card-item.current {
  border-color: var(--text-primary);
  border-width: 4rpx;
}

.card-actions {
  display: flex;
  gap: 20rpx;
}

.card-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.card-btn.redo {
  background: var(--macaron-apricot);
  border: 2rpx solid var(--macaron-apricot-ink);
  color: var(--macaron-apricot-ink);
}

.card-btn.submit {
  background: var(--primary-color);
  color: var(--white);
}

.analysis-body {
  padding: 0;
}

.analysis-prefix {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.analysis-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
}

/* 上报弹窗 */
.report-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.report-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.report-content {
  position: relative;
  width: 100%;
  background: var(--white);
  border-radius: 26rpx 26rpx 0 0;
  padding: 40rpx 26rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  border: 2rpx solid var(--border-color);
}

.report-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

.report-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 26rpx;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
}

.report-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.report-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: calc(50% - 10rpx);
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.report-option.selected {
  background: var(--primary-light);
  color: var(--primary-color);
}

.report-option .checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--text-deco);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.report-option.selected .checkbox {
  border-color: var(--primary-color);
  background: var(--primary-color);
}

.report-option .checkbox.checked::after {
  content: '';
  width: 18rpx;
  height: 10rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

.report-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 26rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 26rpx;
  box-sizing: border-box;
}

.report-actions {
  display: flex;
  gap: 20rpx;
}

.report-btn {
  flex: 1;
  padding: 26rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.report-btn.cancel {
  background: var(--border-color);
  color: var(--text-secondary);
}

.report-btn.submit {
  background: var(--primary-color);
  color: var(--white);
}

/* 底部操作栏 */
.practice-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--white);
  border-top: 2rpx solid var(--border-color);
}

.footer-left,
.footer-right {
  flex: 1;
}

.footer-right {
  display: flex;
  justify-content: flex-end;
}

.footer-center {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 36rpx;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 38rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.nav-btn.disabled {
  opacity: 0.4;
}

.nav-btn.primary {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: var(--white);
  font-weight: 600;
  padding: 0 36rpx;
}

.nav-btn-hover {
  background: var(--bg-color);
}

.nav-btn-primary-hover {
  opacity: 0.85;
}

/* 中间操作：图标 + 文字，不用色块底 */
.footer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  line-height: 1.2;
  color: var(--text-tertiary);
}

.footer-action-icon {
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 8rpx;
  opacity: 0.55;
}

/* 已收藏时图标本身是彩色的，不再压低透明度 */
.favorite-btn.active .footer-action-icon {
  opacity: 1;
}

.favorite-btn.active {
  color: var(--primary-deep);
}

.footer-action-glyph {
  font-size: 34rpx;
  line-height: 38rpx;
  height: 38rpx;
  margin-bottom: 8rpx;
}

.footer-action-hover {
  opacity: 0.55;
}

.remove-wrong-btn {
  color: var(--danger-text);
}

/* 加载状态 */
.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s ease;
}

.loading-state[hidden] {
  display: none !important;
}

/* 进度恢复弹窗 */
.resume-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.resume-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.resume-content {
  position: relative;
  width: 80%;
  max-width: 600rpx;
  background: var(--white);
  border-radius: 26rpx;
  padding: 50rpx 40rpx;
  border: 2rpx solid var(--border-color);
}

.resume-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
  color: var(--text-primary);
}

.resume-info {
  margin-bottom: 40rpx;
}

.resume-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.resume-item:last-child {
  border-bottom: none;
}

.resume-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.resume-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.resume-actions {
  display: flex;
  gap: 20rpx;
}

.resume-btn {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.resume-btn.cancel {
  background: var(--border-color);
  color: var(--text-secondary);
}

.resume-btn.confirm {
  background: var(--primary-color);
  color: var(--white);
}
