.index-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

/* 轮播图 */
.banner-section {
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-swiper {
  height: 300rpx;
  border-radius: 16rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

/* 公告区域 */
.notice-section {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.notice-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  height: 44rpx;
  overflow: hidden;
}

.notice-swiper {
  height: 44rpx;
}

.notice-text {
  font-size: 28rpx;
  color: #333;
  line-height: 44rpx;
}

/* 内容区块 */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-title-line {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #07c160 0%, #05a050 100%);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.section-more .arrow {
  margin-left: 4rpx;
  font-size: 32rpx;
}

/* 列表 */
.list {
  padding: 0;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.title-box {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.top-tag {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.title {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  flex: 1;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date {
  font-size: 24rpx;
  color: #999;
}

/* 分类标签 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-0 {
  background-color: #e6f7f0;
  color: #07c160;
}

.tag-1 {
  background-color: #fff2e8;
  color: #ff7a45;
}

.tag-2 {
  background-color: #e6f4ff;
  color: #1890ff;
}

.tag-3 {
  background-color: #f6ffed;
  color: #52c41a;
}

.tag-4 {
  background-color: #fff0f6;
  color: #eb2f96;
}

/* 空状态 */
.empty-box {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
