.index-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 30rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--border-color);
}

.search-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 轮播图 */
.banner-section {
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-swiper {
  height: 300rpx;
  border-radius: 16rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

/* 公告区域 */
.notice-section {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border-color);
}

.notice-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  height: 44rpx;
  overflow: hidden;
}

.notice-swiper {
  height: 44rpx;
}

.notice-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 44rpx;
}

/* 内容区块 */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid var(--border-color);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-title-line {
  width: 6rpx;
  height: 32rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.section-more .arrow {
  margin-left: 4rpx;
  font-size: 32rpx;
}

/* 列表 */
.list {
  padding: 0;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.title-box {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.top-tag {
  background: var(--white);
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.title {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.5;
  flex: 1;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 分类标签 */
.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 标签一律描边式，不再五色浅底 */
.tag-0,
.tag-1,
.tag-2,
.tag-3,
.tag-4 {
  background-color: transparent;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-deep);
}

/* 空状态 */
.empty-box {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}
