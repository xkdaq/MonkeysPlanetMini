/* pages/legal/legal.wxss */

.legal-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 文档头 */
.doc-head {
  padding: 0 4rpx 32rpx;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
}

.doc-meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 正文卡 */
.doc-body {
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 8rpx 32rpx 32rpx;
}

/* 章标题：绿色小标，和正文拉开层级 */
.b-h1 {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--border-color);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.b-h1:first-child {
  margin-top: 24rpx;
  padding-top: 0;
  border-top: none;
}

/* 节标题 */
.b-h2 {
  margin-top: 26rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-deep);
  line-height: 1.5;
}

.b-p {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--text-secondary);
}

/* 列表项：绿色小圆点挂在左侧 */
.b-li {
  position: relative;
  margin-top: 14rpx;
  padding-left: 26rpx;
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--text-secondary);
}

.b-li::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  opacity: 0.55;
}

/* 结尾确认语：绿浅底强调块 */
.b-note {
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  border-radius: var(--radius-s);
  font-size: 25rpx;
  line-height: 1.85;
  color: var(--primary-deep);
}

/* 复制邮箱 */
.doc-contact {
  margin-top: 28rpx;
  padding: 26rpx;
  text-align: center;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  font-size: 25rpx;
  color: var(--primary-deep);
}

.doc-contact-hover {
  background: var(--bg-color);
}

.doc-foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-deco);
}

.doc-empty {
  padding: 160rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-tertiary);
}
