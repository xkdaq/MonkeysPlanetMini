/* pages/setting/setting.wxss */

.settings-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f5f5 40%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.logo-wrap {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.15);
  margin-bottom: 30rpx;
  padding: 20rpx;
}

.logo-wrap:active {
  transform: scale(0.95);
}

.logo {
  width: 160rpx;
  height: 160rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #999;
}

/* 信息卡片 */
.info-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 60rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
}

.info-label {
  font-size: 30rpx;
  color: #666;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.info-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 40rpx;
}

/* 底部版权 */
.footer {
  margin-top: auto;
  padding-bottom: 40rpx;
}

.copyright {
  font-size: 24rpx;
  color: #999;
}
