/* pages/setting/setting.wxss */

.settings-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.logo-wrap {
  width: 140rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-color);
  margin-bottom: 30rpx;
  padding: 20rpx;
}

.logo-wrap:active {
  opacity: 0.7;
}

.logo {
  width: 160rpx;
  height: 160rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 信息卡片 */
.info-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 0;
  border: 2rpx solid var(--border-color);
  margin-bottom: 60rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
}

.info-label {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.info-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 0 40rpx;
}

/* 底部版权 */
.footer {
  margin-top: auto;
  padding-bottom: 40rpx;
}

.copyright {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
