<!--pages/wrong/wrong.wxml-->
<view class="container">
  <!-- 头部：总览 + 全部练习 -->
  <view class="header-bar" wx:if="{{categories.length > 0 || wrongs.length > 0}}">
    <text class="total-text" wx:if="{{grouped}}">共 {{categories.length}} 个章节 · {{totalCount}} 道错题</text>
    <text class="total-text" wx:else>共 {{wrongs.length}} 道错题</text>
    <text class="all-practice" hover-class="all-practice-hover" hover-start-time="0" hover-stay-time="70" bindtap="startAllPractice">全部练习</text>
  </view>

  <!-- 按分类分组的错题列表 -->
  <view class="category-list" wx:if="{{grouped && categories.length > 0}}">
    <view class="category-card {{expandedCategories.includes(catIndex) ? 'is-open' : ''}}" wx:for="{{categories}}" wx:for-index="catIndex" wx:key="categoryId">
      <!-- 分类标题：练习按钮提到右侧 -->
      <view class="category-header" hover-class="category-header-hover" hover-start-time="0" hover-stay-time="70" bindtap="toggleCategory" data-index="{{catIndex}}">
        <view class="category-info">
          <view class="category-name">{{item.categoryName}}</view>
          <view class="category-count">{{item.count}} 道错题</view>
        </view>
        <text class="practice-btn" catchtap="startCategoryPractice" data-index="{{catIndex}}">练习</text>
        <text class="expand-icon {{expandedCategories.includes(catIndex) ? 'expanded' : ''}}">▾</text>
      </view>

      <!-- 展开后：题干 + 答案对比 -->
      <view class="category-wrongs" wx:if="{{expandedCategories.includes(catIndex)}}">
        <view
          class="wrong-item"
          wx:for="{{item.wrongs}}"
          wx:for-item="wrong"
          wx:for-index="wrongIndex"
          wx:key="id"
          hover-class="wrong-item-hover"
          hover-start-time="0"
          hover-stay-time="70"
          bindtap="onWrongTap"
          data-id="{{wrong.id}}"
          data-category-index="{{catIndex}}"
          data-wrong-index="{{wrongIndex}}"
        >
          <view class="question-text">{{wrong.question.content}}</view>
          <view class="answer-row">
            <text class="answer-cell">你的答案 <text class="value is-wrong">{{wrong.userAnswer || '未作答'}}</text></text>
            <text class="answer-cell" wx:if="{{wrong.userAnswer}}">正确答案 <text class="value is-correct">{{wrong.question.answer}}</text></text>
          </view>
          <view class="wrong-meta">错 {{wrong.wrongCount}} 次 · {{wrong.lastWrongTime}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 平铺错题列表（兼容旧格式） -->
  <view class="wrong-list" wx:if="{{!grouped && wrongs.length > 0}}">
    <view
      class="wrong-item is-standalone"
      wx:for="{{wrongs}}"
      wx:key="id"
      hover-class="wrong-item-hover"
      hover-start-time="0"
      hover-stay-time="70"
      bindtap="onWrongTap"
      data-id="{{item.id}}"
      data-index="{{index}}"
    >
      <view class="question-text">{{item.question.content}}</view>
      <view class="answer-row">
        <text class="answer-cell">你的答案 <text class="value is-wrong">{{item.userAnswer || '未作答'}}</text></text>
        <text class="answer-cell" wx:if="{{item.userAnswer}}">正确答案 <text class="value is-correct">{{item.question.answer}}</text></text>
      </view>
      <view class="wrong-meta">错 {{item.wrongCount}} 次 · {{item.lastWrongTime}}</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{(grouped && categories.length === 0) || (!grouped && wrongs.length === 0)}}">
    <text>暂无错题记录</text>
    <text class="sub-text">答错的题目会出现在这里</text>
  </view>
</view>
