/* pages/wrong/wrong.wxss */

.container {
  min-height: 100vh;
  background: var(--bg-color);
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 头部 */
.header-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 24rpx;
}

.total-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.all-practice {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--primary-deep);
  padding: 4rpx 0 4rpx 20rpx;
}

.all-practice-hover {
  opacity: 0.6;
}

/* 章节卡 */
.category-card {
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 22rpx;
}

.category-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 30rpx;
}

.category-header-hover {
  background: var(--bg-color);
}

/* 展开态：章节头上绿浅底 */
.category-card.is-open .category-header {
  background: var(--primary-light);
  border-bottom: 2rpx solid var(--primary-line);
}

.category-card.is-open .category-header-hover {
  background: var(--primary-light);
}

.category-info {
  flex: 1;
  min-width: 0;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 练习按钮：提到章节行右侧 */
.practice-btn {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-deep);
  background: var(--white);
  border: 2rpx solid var(--primary-line);
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
}

.expand-icon {
  flex: none;
  font-size: 20rpx;
  color: var(--text-deco);
  transition: transform 0.2s ease;
}

.expand-icon.expanded {
  transform: rotate(180deg);
  color: var(--text-tertiary);
}

/* 展开的错题 */
.category-wrongs {
  padding: 0 30rpx;
}

.wrong-item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-item-hover {
  opacity: 0.6;
}

.wrong-item.is-standalone {
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
}

.question-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.answer-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
}

.answer-cell {
  font-size: 23rpx;
  color: var(--text-tertiary);
}

.value {
  font-weight: 600;
}

.value.is-wrong {
  color: var(--danger-text);
}

.value.is-correct {
  color: var(--primary-deep);
}

.wrong-meta {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.sub-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-deco);
}
