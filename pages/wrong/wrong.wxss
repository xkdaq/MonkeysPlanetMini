/* pages/wrong/wrong.wxss */

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: var(--white);
  margin: 0 14rpx 20rpx 14rpx;
  border-radius: 8rpx;
}

.total-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 分类列表 */
.category-list {
  padding: 0;
  padding-bottom: 30rpx;
}

.category-item {
  background: var(--white);
  border-radius: 16rpx;
  margin: 0 14rpx 20rpx 14rpx;
  overflow: hidden;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #f8f9fa;
}

.category-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.category-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.category-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.category-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.practice-category-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  background: var(--primary-light);
  border-radius: 24rpx;
}

.expand-icon {
  font-size: 24rpx;
  color: var(--text-tertiary);
  transition: transform 0.3s;
}

.expand-icon.expanded {
  transform: rotate(180deg);
}

.category-wrongs {
  padding: 20rpx 30rpx;
}

/* 错题列表 */
.wrong-list {
  padding: 0 30rpx;
  padding-bottom: 30rpx;
}

.wrong-item {
  display: flex;
  background: var(--white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.wrong-content {
  flex: 1;
}

.question-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wrong-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.wrong-count {
  font-size: 24rpx;
  color: var(--danger-color);
}

.wrong-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.your-answer,
.correct-answer {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.your-answer .label,
.correct-answer .label {
  color: var(--text-secondary);
}

.your-answer .value.wrong {
  color: var(--danger-color);
}

.correct-answer .value.correct {
  color: var(--primary-color);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-state text {
  font-size: 32rpx;
  color: var(--text-secondary);
}

.empty-state .sub-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 16rpx;
}
