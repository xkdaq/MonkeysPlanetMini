/**app.wxss**/
@import "styles/common.wxss";

/**
 * 设计规范 4B「描边卡片」
 * 近白底 / 1px 描边圆角卡 / 零阴影
 * 绿色只用在：描边、标签、单个主按钮
 */
page {
  /* 主色 */
  --primary-color: #07c160;   /* 主绿：主按钮、进度条、强调描边 */
  --primary-deep: #09814a;    /* 深绿：绿色文字（保证对比度） */
  --primary-light: #f1faf5;   /* 绿浅底：标签、强调卡背景 */
  --primary-line: #d9efe4;    /* 绿描边 */

  /* 文字 */
  --text-primary: #2b3230;
  --text-secondary: #6b7572;
  --text-tertiary: #68726f;
  --text-deco: #c3cbc7;       /* 箭头、分隔符等装饰性符号 */

  /* 背景与描边 */
  --bg-color: #fbfcfb;        /* 页面底：近白 */
  --white: #ffffff;           /* 卡片底 */
  --border-color: #eef1ef;    /* 卡片描边、分割线 */

  /* 语义色：错误 */
  --danger-color: #c0392b;    /* 实心底（选项序号等） */
  --danger-text: #a33327;     /* 红字 */
  --danger-line: #f0b6b2;     /* 红描边 */
  --danger-light: #fdf4f3;    /* 红浅底 */

  /* 语义色：提醒 / 次要玩法 */
  --warning-color: #8a5911;   /* 棕字 */
  --warning-line: #f2e3c6;    /* 棕描边 */
  --warning-light: #fdf6e9;   /* 棕浅底 */

  /* 马卡龙色板：与抽题大转盘同一套，用于需要多色区分状态的色块
     （低饱和浅底 + 同色系深字，替代大面积深色实心） */
  --macaron-mint: #bfeedd;
  --macaron-mint-ink: #1f6b4a;
  --macaron-apricot: #fde2c4;
  --macaron-apricot-ink: #8a5911;
  --macaron-rose: #ffd6d6;
  --macaron-rose-ink: #a33a3a;

  /* 圆角 */
  --radius: 32rpx;
  --radius-s: 24rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Segoe UI', sans-serif;
  background-color: var(--bg-color);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
}

/* 卡片：描边，无阴影 */
.card {
  background: var(--white);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

/* 强调卡：绿浅底 + 绿描边 */
.card-accent {
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  border-radius: var(--radius);
  padding: 32rpx;
}

.card-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* 分组小标题：卡片外的段落标题 */
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 20rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-title .section-extra {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--text-tertiary);
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: var(--primary-color);
  color: var(--white);
}

.btn-primary:active {
  opacity: 0.85;
}

/* 次按钮：绿描边、白底 */
.btn-ghost {
  background: var(--white);
  color: var(--primary-deep);
  border: 2rpx solid var(--primary-color);
}

.btn-default {
  background: var(--white);
  color: var(--text-secondary);
  border: 2rpx solid var(--border-color);
}

.btn-danger {
  background: var(--danger-color);
  color: var(--white);
}

/* 标签：一律描边式，不用五色浅底 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.tag-primary {
  background: var(--primary-light);
  border: 2rpx solid var(--primary-line);
  color: var(--primary-deep);
}

.tag-default {
  background: transparent;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
}

.tag-warning {
  background: var(--warning-light);
  border: 2rpx solid var(--warning-line);
  color: var(--warning-color);
}

.tag-danger {
  background: var(--danger-light);
  border: 2rpx solid var(--danger-line);
  color: var(--danger-text);
}

/* 文本样式 */
.text-primary {
  color: var(--primary-deep);
}

.text-danger {
  color: var(--danger-text);
}

.text-warning {
  color: var(--warning-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

/* 箭头 */
.arrow {
  flex: none;
  font-size: 28rpx;
  color: var(--text-deco);
}

/* flex布局 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }

.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }

.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
}

.empty-state text {
  margin-top: 20rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  color: var(--text-tertiary);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
